# ---------------------------------------------------------------------------
# Copy to `.env.local` (gitignored) and fill in. On Vercel, set the same names
# under Project → Settings → Environment Variables.
#
# The site builds and every form still works with none of this present:
# bookings fall back to a pre-filled WhatsApp handoff and report
# `persisted: false`. See lib/firebase-admin.js and app/api/bookings/route.js.
# ---------------------------------------------------------------------------

# --- Firebase web config ---------------------------------------------------
# Firebase console → Project settings → General → Your apps → Web app.
# Or: `firebase apps:sdkconfig WEB --project <project-id>`.
#
# These are public by design — they ship in the browser bundle and identify the
# project, they do not protect it. `firestore.rules` is what protects it.
# Only the /admin sign-in needs them; bookings do not.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server only) ------------------------------------------
# Firebase console → Project settings → Service accounts → "Generate new
# private key". Paste the entire JSON on ONE line, wrapped in single quotes.
#
# This is the credential that actually writes bookings. Treat it like a
# password: it bypasses Firestore rules completely. Never prefix it
# NEXT_PUBLIC_ — that would publish it to every visitor.
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Admin access ----------------------------------------------------------
# Comma-separated Google accounts allowed into /admin, checked server-side
# against the verified ID token. Empty means nobody gets in (fails closed).
ADMIN_EMAILS=

# --- EmailJS (server only) -------------------------------------------------
# Sends the new-booking alert. Called from the server with the private key as
# `accessToken`, so no domain allowlisting is needed and nothing is public.
# Keys: EmailJS dashboard → Account → API keys. Template: Email Templates.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# --- EmailJS: the payment-started alert (server only) ----------------------
# A SECOND template, separate from the booking alert above.
#
# This is the safety net for the fact that WiPay has no webhook: the payment
# outcome reaches us only through the guest's browser, so a closed tab can leave
# a real charge unrecorded. This email fires when a payment is STARTED, giving
# the owner an order_id to search in the WiPay dashboard if nothing follows it.
#
# Deliberately NOT part of isNotifyConfigured(). If it were, deploying the
# payment code without setting this would silently switch off booking alerts.
# Template params: reference, order_id, amount, provider, environment, name,
# tour, date, started_at.
EMAILJS_TEMPLATE_ID_PAYMENT=

# --- WiPay (server only) ---------------------------------------------------
# Leave ALL of these blank and the site behaves exactly as it did before
# payments existed: the form takes a request, the guest settles with the driver,
# and no card option is offered anywhere.
#
# WIPAY_API_KEY is the credential that signs and verifies transactions. Never
# prefix it NEXT_PUBLIC_ — publishing it lets anyone forge a "paid" hash for any
# amount, which is total compromise of the payment story. Same class of secret
# as FIREBASE_SERVICE_ACCOUNT_KEY above.
#
# Sandbox works with no account at all: environment=sandbox falls back to the
# published test pair (account 1234567890, key 123) and computes real hashes, so
# the verification path is genuinely exercised in development. Going live is
# these two values plus WIPAY_ENVIRONMENT=live — no code change.
#
# Live requires a WiPay Business Account that is VERIFIED, which in Jamaica
# means a business bank account in the company's name; a personal account will
# not do. Key: WiPay dashboard -> Developer.
WIPAY_ENVIRONMENT=sandbox
WIPAY_ACCOUNT_NUMBER=
WIPAY_API_KEY=
# JM | TT | BB | GY. Picks the API endpoint; keep it matching the account.
WIPAY_COUNTRY_CODE=JM
# customer_pay | merchant_absorb | split.
#
# merchant_absorb is the default and the deliberate choice: the guest is charged
# exactly the fare published on the site, and the ~3.5% is carried in those
# prices instead. Anything else puts a processing fee on the last screen, which
# contradicts "no fuel levy, no airport surcharge, what you see is the whole
# fare" on every transfer page.
#
# Changing this to customer_pay also breaks an assumption in the return route:
# it compares the reported total to the requested one exactly. Under
# customer_pay WiPay adds its fee and the reported total is higher, so that
# check has to become >= with the difference recorded as a fee. Read the comment
# there before switching.
WIPAY_FEE_STRUCTURE=merchant_absorb

# --- Local payment testing -------------------------------------------------
# PAYMENTS_MOCK=1 replaces the provider with a fake hosted page at
# /api/payments/mock, offering succeed / decline / cancel / forge / underpay
# buttons that redirect into the REAL return route with REAL hashes. It exists
# because response_url cannot be localhost, so the alternative is a tunnel.
#
# Ignored when NODE_ENV=production, and lib/payments/index.js refuses to select
# it there regardless of what this says.
PAYMENTS_MOCK=

# Overrides site.url. Set this to a tunnel hostname (cloudflared, localtunnel)
# when testing the real WiPay sandbox end to end, since response_url must be
# reachable from the internet. Leave blank otherwise.
SITE_URL=
