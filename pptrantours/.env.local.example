# ---------------------------------------------------------------------------
# Copy to `.env.local` (gitignored) and fill in. On Vercel, set the same names
# under Project → Settings → Environment Variables.
#
# The site builds and every form still works with none of this present:
# bookings fall back to a pre-filled WhatsApp handoff and report
# `persisted: false`. See lib/firebase-admin.js and app/api/bookings/route.js.
# ---------------------------------------------------------------------------

# --- Firebase web config ---------------------------------------------------
# Firebase console → Project settings → General → Your apps → Web app.
# Or: `firebase apps:sdkconfig WEB --project <project-id>`.
#
# These are public by design — they ship in the browser bundle and identify the
# project, they do not protect it. `firestore.rules` is what protects it.
# Only the /admin sign-in needs them; bookings do not.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server only) ------------------------------------------
# Firebase console → Project settings → Service accounts → "Generate new
# private key". Paste the entire JSON on ONE line, wrapped in single quotes.
#
# This is the credential that actually writes bookings. Treat it like a
# password: it bypasses Firestore rules completely. Never prefix it
# NEXT_PUBLIC_ — that would publish it to every visitor.
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Admin access ----------------------------------------------------------
# Comma-separated Google accounts allowed into /admin, checked server-side
# against the verified ID token. Empty means nobody gets in (fails closed).
ADMIN_EMAILS=

# --- EmailJS (server only) -------------------------------------------------
# Sends the new-booking alert. Called from the server with the private key as
# `accessToken`, so no domain allowlisting is needed and nothing is public.
# Keys: EmailJS dashboard → Account → API keys. Template: Email Templates.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
