rules_version = '2';

// Deny every client request, deliberately.
//
// Bookings are written server-side with the Firebase Admin SDK, which bypasses
// rules entirely — so these denials cost us nothing and buy a lot. Guest names,
// emails, phone numbers and flight details are never readable from a browser,
// and there is no permissive create rule to get subtly wrong.
//
// This matters more than usual here: the repo is public, so the
// NEXT_PUBLIC_FIREBASE_* config ships to anyone who looks. Those keys identify
// the project, they do not protect it — these rules are the only thing that does.
//
// The server route that made this safe now exists, and these rules are
// deployed and verified: an unauthenticated read with the real web API key
// returns 403 PERMISSION_DENIED. Bookings are written by
// app/api/bookings/route.js and read by app/api/admin/bookings/route.js, both
// via the Admin SDK.
//
// DEPENDENCY: nothing in a browser may touch Firestore. lib/firebase.js
// deliberately exports Auth only — if you add a client getDb() and query it,
// it will compile and then fail here at runtime.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
